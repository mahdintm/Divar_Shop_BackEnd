# Database
Host_MYSQL=127.0.0.1
Username_MYSQL=your_mysql_username
Password_MYSQL=your_mysql_password
Database_MYSQL_Main=Divar_Shop
Port_MYSQL=3306

# Application authentication
TOKEN_KEY=replace_with_a_secure_random_key

# LDAP / Active Directory
LDAP_URL=ldap://your-ldap-host
LDAP_BASE_DN=dc=example,dc=ir
LDAP_BIND_DN=your_ldap_bind_account
LDAP_BIND_CREDENTIALS=your_ldap_bind_password

# HTTP server
PORT=3001
# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://shop.agahpardazan.ir,https://shop.agahpardazan.ir,http://172.20.10.16
